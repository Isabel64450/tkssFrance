{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-2xl mx-auto py-8">

    <h1 class="text-2xl font-bold text-gray-800 mb-4">Résumé des paiements</h1>

    <div class="bg-gray-50 p-4 rounded-lg mb-6">
        <p class="text-gray-700">Montant total de la commande :</p>
        <p class="text-2xl font-bold text-green-600">{{ order.totalPrice }} €</p>
        <p class="text-gray-700 mt-2">Montant déjà payé :</p>
        <p class="text-xl font-semibold text-blue-600">{{ paymentsTotal }} €</p>
        <p class="text-gray-700 mt-2">Reste à payer :</p>
        <p class="text-xl font-semibold text-red-600">{{ order.totalPrice - paymentsTotal }} €</p>
    </div>

    <h2 class="text-xl font-semibold mb-2">Historique des paiements :</h2>
    <ul class="mb-6">
        {% for payment in payments %}
            <li class="border-b py-2">
                Méthode : {{ payment.method }} |
                Montant : {{ payment.amount }} € |
                Date : {{ payment.createdAt|date('d/m/Y H:i') }} |
                Statut : {{ payment.isCompleted ? 'Complet' : 'Partiel' }}
            </li>
        {% else %}
            <li>Aucun paiement enregistré pour cette commande.</li>
        {% endfor %}
    </ul>

    {% if order.totalPrice - paymentsTotal > 0 %}
        <a href="{{ path('app_payment_cash_add', {'id': order.id}) }}" 
           class="inline-block bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition mb-4">
            Effectuer un autre paiement
        </a>
    {% endif %}

    <a href="{{ path('app_homepage') }}" 
       class="inline-block bg-gray-200 text-gray-800 px-6 py-2 rounded-lg hover:bg-gray-300 transition">
        Retour à l'accueil
    </a>

</div>
{% endblock %}