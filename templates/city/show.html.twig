{% extends 'base.html.twig' %}

{% block title %}City{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto mt-10 p-6 bg-white shadow-lg rounded-lg">

    <h1 class="text-2xl font-bold text-[#003049] mb-6 text-center">
        Détail de la ville
    </h1>

    <div class="space-y-4">

        <div class="flex justify-between border-b pb-2">
            <span class="font-semibold text-gray-600">ID</span>
            <span class="text-gray-800">{{ city.id }}</span>
        </div>

        <div class="flex justify-between border-b pb-2">
            <span class="font-semibold text-gray-600">Nom</span>
            <span class="text-gray-800">{{ city.name }}</span>
        </div>

        <div class="flex justify-between border-b pb-2">
            <span class="font-semibold text-gray-600">Frais de livraison</span>
            <span class="text-gray-800">{{ city.shippingCost }} €</span>
        </div>

    </div>

    <div class="flex justify-between items-center mt-8">

        <a href="{{ path('app_city_index') }}" 
           class="px-4 py-2 rounded bg-[#669bbc] text-white hover:bg-[#003049] transition">
            ← Retour
        </a>

        <a href="{{ path('app_city_edit', {'id': city.id}) }}" 
           class="px-4 py-2 rounded bg-gradient-to-r from-[#780000] to-[#c1121f] text-white hover:from-[#c1121f] hover:to-[#780000] transition">
            Modifier
        </a>

    </div>

    <div class="mt-6 text-center">
        {{ include('city/_delete_form.html.twig') }}
    </div>

</div>
{% endblock %}