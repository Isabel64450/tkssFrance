{{ form_start(form) }}

<div class="space-y-4">

    {{ form_errors(form) }}

    {% for field in form %}
        <div>
            {{ form_label(field, null, {
                'label_attr': {
                    'class': 'block text-gray-700 font-semibold mb-1'
                }
            }) }}

            {{ form_widget(field, {
                'attr': {
                    'class': 'w-full px-3 py-2 border border-gray-300 rounded shadow-sm focus:outline-none focus:ring-2 focus:ring-[#669bbc]'
                }
            }) }}

            {{ form_errors(field) }}
        </div>
    {% endfor %}

</div>

<button class="w-full mt-6 py-2 px-4 rounded text-white font-semibold 
               bg-gradient-to-r from-[#780000] to-[#c1121f] 
               hover:from-[#c1121f] hover:to-[#780000] transition">
    {{ button_label|default('Save') }}
</button>

{{ form_end(form) }}