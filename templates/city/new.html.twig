{% extends 'base.html.twig' %}

{% block title %}New City{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto mt-10 p-6 bg-white shadow-lg rounded-lg">

    <h1 class="text-2xl font-bold text-[#003049] mb-6 text-center">
        Ajouter une ville
    </h1>

    {{ include('city/_form.html.twig') }}

    <div class="mt-6 text-center">
        <a href="{{ path('app_city_index') }}" 
           class="inline-block px-4 py-2 rounded bg-[#669bbc] text-white hover:bg-[#003049] transition">
            ← Retour à la liste
        </a>
    </div>

</div>
{% endblock %}