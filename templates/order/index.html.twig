{% extends 'base.html.twig' %}

{% block title %}Commande{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        
        <div class="md:col-span-2">
            <h1 class="text-2xl font-bold my-6">Commande</h1>

            {{ form_start(form, {
                attr: { class: 'space-y-6 bg-white p-6 rounded-2xl shadow-md' }
            }) }}

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-gray-700">Prénom</label>
                    <input type="text" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-gray-100"
                           value="{{ app.user.firstName }}" disabled>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-700">Nom</label>
                    <input type="text" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-gray-100"
                           value="{{ app.user.lastName }}" disabled>
                </div>
            </div>

            <div>
                <label class="text-sm font-medium text-gray-700">Email</label>
                <input type="email" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-gray-100"
                       value="{{ app.user.email }}" disabled>
            </div>
              <div>
                <label class="text-sm font-medium text-gray-700">Téléphone</label>
                <input type="text" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-gray-100"
                       value="{{ app.user.telephoneNumber }}" disabled>
            </div>

            <div>
                <label class="text-sm font-medium text-gray-700">Adresse</label>
                <input type="text" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-gray-100"
                       value="{{ app.user.address }}" disabled>
            </div>

            <div>
                <label class="text-sm font-medium text-gray-700">Ville</label>
                <input type="text" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 bg-gray-100"
                       value="{{ app.user.city.name }}" disabled>
            </div>
         
            <div>
                <label class="text-sm font-medium text-gray-700">Mode de paiement</label>
                {{ form_row(form.paymentMethod) }}
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition">
                Passer la commande
            </button>

            {{ form_end(form) }}
        </div>

      
        <div class="bg-gray-50 p-6 rounded-2xl shadow-md h-fit mt-6 md:mt-0">
            <div class="space-y-4">
                <div>
                    <span class="text-gray-600">Montant à payer:</span>
                    <h3 class="text-xl font-bold">
                        <span>{{ total | number_format(2, '.', ',') }}</span> €
                    </h3>
                </div>
                <div class="border-t pt-4">
                    <span class="text-gray-800 font-medium">Montant total</span>
                    <h3 class="text-2xl font-bold text-green-600">
                        <span>{{ total | number_format(2, '.', ',') }}</span> €
                    </h3>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}