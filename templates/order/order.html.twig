{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 mt-10">
    <h1 class="text-3xl font-bold mb-6 text-[#003049]">Commandes</h1>

    {% for order in orders %}
        <div class="bg-white rounded-2xl shadow-md mb-6 overflow-hidden border border-gray-200">

            <!-- Header -->
            <div class="flex justify-between items-center px-6 py-4 bg-[#003049] text-white">
                <span class="font-semibold">Commande #{{ order.id }}</span>
                <span class="text-sm">{{ order.createdAt|date('d/m/Y H:i') }}</span>
            </div>

            <div class="p-6">

                <!-- Infos -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- Client -->
                    <div>
                        <h5 class="text-lg font-semibold text-[#780000] mb-2">Client</h5>
                        <p><strong>Nom :</strong> {{ order.firstName }} {{ order.lastName }}</p>
                        <p><strong>Téléphone :</strong> {{ order.telephoneNumber }}</p>
                        <p><strong>Adresse :</strong> {{ order.address }}</p>
                        <p><strong>Ville :</strong> {{ order.city.name ?? 'Non définie' }}</p>
                    </div>

                    <!-- Détails -->
                    <div>
                        <h5 class="text-lg font-semibold text-[#780000] mb-2">Détails</h5>

                        <p class="mb-2">
                            {% if order.isCompleted %}
                                <span class="text-green-600 font-medium">Order delivered</span>
                            {% else %}
                                <span class="text-red-600 font-medium">Order not delivered</span>
                            {% endif %}
                        </p>

                        <p><strong>Total :</strong> {{ order.totalPrice }} €</p>
                    </div>
                </div>

                <hr class="my-6">

                <!-- Produits -->
                <h5 class="text-lg font-semibold text-[#780000] mb-4">Produits</h5>

                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm text-left">
                        <thead class="bg-[#fdf0d5] text-[#003049]">
                            <tr>
                                <th class="px-4 py-2">Image</th>
                                <th class="px-4 py-2">Produit</th>
                                <th class="px-4 py-2">Prix</th>
                                <th class="px-4 py-2">Quantité</th>
                                <th class="px-4 py-2">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for op in order.orderProducts %}
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="px-4 py-2">
                                        <img src="/uploads/images/{{ op.product.images }}"
                                             class="w-16 h-16 object-cover rounded"
                                             alt="{{ op.product.name }}">
                                    </td>
                                    <td class="px-4 py-2">{{ op.product.name }}</td>
                                    <td class="px-4 py-2">{{ op.product.price }} €</td>
                                    <td class="px-4 py-2">{{ op.quantity }}</td>
                                    <td class="px-4 py-2">{{ op.product.price * op.quantity }} €</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-gray-500 py-4">
                                        Aucun produit
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Footer actions -->
                <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mt-6">

                    <div class="space-y-1">
                        <h5 class="text-[#003049] font-semibold">
                            Delivery cost: {{ order.city.shippingCost }} €
                        </h5>
                        <h5 class="text-[#c1121f] font-bold text-lg">
                            Total to pay: {{ order.totalPrice }} €
                        </h5>
                    </div>

                    <div class="flex flex-wrap gap-3">

                        <a href="{{ path('app_bill', {'id': order.id}) }}"
                           class="px-4 py-2 border border-[#669bbc] text-[#669bbc] rounded-lg hover:bg-[#669bbc] hover:text-white transition">
                            Imprimer la facture
                        </a>

                        <a href="{{ path('app_orders_is-completed-update', {'id': order.id}) }}"
                           class="px-4 py-2 rounded-lg text-white transition
                           {{ order.isCompleted 
                                ? 'bg-green-600 hover:bg-green-700' 
                                : 'bg-yellow-500 hover:bg-yellow-600' }}">
                            {{ order.isCompleted ? 'Mark as not delivered' : 'Mark as delivered' }}
                        </a>

                        <a onclick="return confirm('Voulez-vous vraiment supprimer cette commande ?')"
                           href="{{ path('app_orders_remove', {'id': order.id}) }}"
                           class="px-4 py-2 border border-[#780000] text-[#780000] rounded-lg hover:bg-[#780000] hover:text-white transition">
                            Delete this purchase
                        </a>

                    </div>
                </div>

            </div>
        </div>

    {% else %}
        <div class="bg-[#fdf0d5] text-[#003049] p-4 rounded-lg">
            Aucune commande trouvée
        </div>
    {% endfor %}

    <div class="mt-6">
        {{ knp_pagination_render(orders, 'layouts/pagination_template.html.twig') }}
    </div>
</div>
{% endblock %}