{% extends 'base.html.twig' %}

{% block title %}Sign In{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-[#fdf0d5]">
    <div class="bg-white shadow-xl rounded-lg p-8 w-full max-w-md">
        
        {% if error %}
            <div class="mb-4 px-4 py-3 rounded text-white bg-[#c1121f]">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="mb-4 px-4 py-3 rounded text-[#003049] bg-[#669bbc]">
                You are logged in as <strong>{{ app.user.userIdentifier }}</strong>,
                <a href="{{ logout_path() }}" class="underline">Logout</a>
            </div>
        {% endif %}

        <h1 class="text-2xl font-bold text-[#780000] text-center mb-6">Sign In</h1>

        <form method="post" class="space-y-4">
            <div>
                <label for="username" class="block mb-1 font-medium text-[#003049]">Email</label>
                <input type="email"
                       name="_username"
                       id="username"
                       value="{{ last_username }}"
                       required
                       autofocus
                       autocomplete="email"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#c1121f] focus:border-[#c1121f]">
            </div>

            <div>
                <label for="password" class="block mb-1 font-medium text-[#003049]">Password</label>
                <input type="password"
                       name="_password"
                       id="password"
                       required
                       autocomplete="current-password"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#c1121f] focus:border-[#c1121f]">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full py-2 mt-2 rounded-lg text-white bg-[#780000] hover:bg-[#c1121f] transition-colors font-semibold">
                Sign In
            </button>
        </form>

        <div class="text-center mt-4 text-[#003049]">
            <small>
                Don’t have an account?
                <a href="{{ path('app_register') }}" class="underline text-[#669bbc] hover:text-[#c1121f]">Register</a>
            </small>
        </div>

    </div>
</div>
{% endblock %}