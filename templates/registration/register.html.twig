{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-[#fdf0d5]">
    <div class="bg-white shadow-xl rounded-lg p-8 w-full max-w-md">
        <h1 class="text-2xl font-bold text-center mb-6 text-[#003049]">Register</h1>

        {{ form_start(registrationForm) }}
        
        <div class="space-y-4">
            
            <div>
                {{ form_label(registrationForm.first_name, 'Prénom', {'label_attr': {'class': 'block mb-1 font-medium text-[#003049]'}}) }}
                {{ form_widget(registrationForm.first_name, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gradient-to-r focus:ring-blue-500 focus:border-blue-500'}}) }}
                {{ form_errors(registrationForm.first_name) }}
            </div>

          
            <div>
                {{ form_label(registrationForm.last_name, 'Nom', {'label_attr': {'class': 'block mb-1 font-medium text-[#003049]'}}) }}
                {{ form_widget(registrationForm.last_name, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gradient-to-r focus:ring-blue-500 focus:border-blue-500'}}) }}
                {{ form_errors(registrationForm.last_name) }}
            </div>

           
            <div>
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block mb-1 font-medium text-[#003049]'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gradient-to-r focus:ring-blue-500 focus:border-blue-500'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>

           
            <div>
                {{ form_label(registrationForm.dateOfBirth, 'Date de naissance', {'label_attr': {'class': 'block mb-1 font-medium text-[#003049]'}}) }}
                {{ form_widget(registrationForm.dateOfBirth, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gradient-to-r focus:ring-blue-500 focus:border-blue-500'}}) }}
                {{ form_errors(registrationForm.dateOfBirth) }}
            </div>

            
            <div>
                {{ form_label(registrationForm.gender, 'Genre', {'label_attr': {'class': 'block mb-1 font-medium text-[#003049]'}}) }}
                {{ form_widget(registrationForm.gender, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gradient-to-r focus:ring-blue-500 focus:border-blue-500'}}) }}
                {{ form_errors(registrationForm.gender) }}
            </div>

            
            <div>
                {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'block mb-1 font-medium text-[#003049]'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gradient-to-r focus:ring-blue-500 focus:border-blue-500'}}) }}
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

           
            <div class="flex items-center">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mr-2'}}) }}
                {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'text-[#003049]'}}) }}
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>

           
            <button type="submit" class="w-full py-2 rounded-lg text-white font-semibold bg-gradient-to-r from-blue-500 to-red-500 hover:from-red-500 hover:to-blue-500 transition-all">
                Register
            </button>
        </div>

        {{ form_end(registrationForm) }}
    </div>
</div>
{% endblock %}