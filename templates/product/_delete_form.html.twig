<form method="post" 
      action="{{ path('app_product_delete', {'id': product.id}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">

    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">

    <button type="submit" 
            class="px-4 py-2 bg-[#c1121f] hover:bg-[#780000] text-white font-semibold rounded-lg transition duration-300">
        Supprimer
    </button>

</form>