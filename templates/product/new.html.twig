{% extends 'base.html.twig' %}

{% block title %}New Product{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto mt-10 bg-white p-8 rounded-lg shadow-md">

    <h1 class="text-3xl font-bold text-gray-800 mb-6">
        Créer un nouveau produit
    </h1>

    {% include 'layouts/_flash_message.html.twig' %}

    <div class="space-y-4">
        {{ include('product/_form.html.twig', {'button_label': 'Enregistrer'}) }}
    </div>

    <div class="mt-6">
        <a href="{{ path('app_product_index') }}"
           class="inline-block text-indigo-600 hover:text-indigo-800 font-medium transition">
            ← Retour à la liste
        </a>
    </div>

</div>
{% endblock %}