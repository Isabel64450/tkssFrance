{% extends 'base.html.twig' %}

{% block title %}Ajouter du stock{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fdf0d5] flex items-center justify-center py-10">

    <div class="w-full max-w-xl bg-white shadow-lg rounded-2xl p-8 border border-[#669bbc]">

        <h1 class="text-2xl md:text-3xl font-bold text-[#003049] mb-6 text-center">
            Ajouter du stock pour : 
            <span class="text-[#c1121f]">{{ product.name }}</span>
        </h1>

        <div class="mb-4">
            {{ include('layouts/_flash_message.html.twig') }}
        </div>

        {{ form_start(form) }}

            <div class="mb-5">
                {{ form_label(form.quantity, null, {'label_attr': {'class': 'block text-[#003049] font-semibold mb-2'}}) }}
                
                {{ form_widget(form.quantity, {
                    'attr': {
                        'class': 'w-full px-4 py-2 border border-[#669bbc] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#669bbc]'
                    }
                }) }}

                {{ form_errors(form.quantity) }}
            </div>

            <button type="submit"
                    class="w-full bg-[#c1121f] hover:bg-[#780000] text-white font-semibold py-2 px-4 rounded-lg transition duration-300">
                Ajouter
            </button>

        {{ form_end(form) }}

    </div>

</div>
{% endblock %}