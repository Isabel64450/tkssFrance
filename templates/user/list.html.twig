{% extends 'base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-6">

    <h2 class="text-3xl font-bold text-[#003049] mb-6">
        Liste des utilisateurs
    </h2>

    {% include 'layouts/_flash_message.html.twig' %}

    <div class="overflow-x-auto bg-white shadow-md rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">

            <thead class="bg-gradient-to-r from-[#003049] to-[#669bbc] text-white">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Prénom</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Nom</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Email</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Rôle</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Actions</th>
                </tr>
            </thead>

            <tbody class="bg-white divide-y divide-gray-200">

                {% for user in users %}
                    <tr class="hover:bg-[#fdf0d5] transition">

                        <td class="px-6 py-4 font-medium text-gray-800">
                            {{ user.firstName }}
                        </td>

                        <td class="px-6 py-4 text-gray-700">
                            {{ user.lastName }}
                        </td>

                        <td class="px-6 py-4 text-gray-600">
                            {{ user.userIdentifier }}
                        </td>

                        <td class="px-6 py-4">
                         {% if user.roles is not empty %}
                         {% set role = user.roles[0] %}
                         {% if role == 'ROLE_ADMIN' %}
                         <span class="px-2 py-1 text-xs font-semibold rounded bg-[#003049] text-white">
                            Admin
                         </span>
                         {% elseif role == 'ROLE_EDITOR' %}
                         <span class="px-2 py-1 text-xs font-semibold rounded bg-[#669bbc] text-white">
                          Éditeur
                         </span>
                        {% elseif role == 'ROLE_MISKY' or role == 'ROLE_KALINCHA' or role == 'ROLE_MAMALA' %}
                         <span class="px-2 py-1 text-xs font-semibold rounded bg-pink-400 text-white">
                         {{ role }}
                         </span>
                        {% elseif role == 'ROLE_CHASCAS' or role == 'ROLE_ROMPES' or role == 'ROLE_PACHAS' or role == 'ROLE_MACHUS' %}
                         <span class="px-2 py-1 text-xs font-semibold rounded bg-blue-400 text-white">
                         {{ role }}
                        </span>
                         {% else %}
                         <span class="px-2 py-1 text-xs font-semibold rounded bg-gray-300 text-gray-700">
                         {{ role }}
                         </span>
                          {% endif %}
                          {% endif %}
                         </td>

                        <td class="px-6 py-4 space-x-2">

                            {% if 'ROLE_ADMIN' not in user.roles %}

                                {% if 'ROLE_EDITOR' not in user.roles %}
                                    <a href="{{ path('app_user_make_editor', {'id': user.id, 'role': 'ROLE_EDITOR'}) }}"
                                       onclick="return confirm('Voulez-vous vraiment affecter ce rôle à cet utilisateur ?')"
                                       class="px-3 py-1 rounded text-white text-sm 
                                              bg-gradient-to-r from-[#003049] to-[#669bbc] 
                                              hover:from-[#669bbc] hover:to-[#003049] transition">
                                        + Éditeur
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_user_delete_editor_role', {'id': user.id}) }}"
                                       onclick="return confirm('Voulez-vous vraiment retirer ce rôle ?')"
                                       class="px-3 py-1 rounded text-white text-sm 
                                              bg-gradient-to-r from-[#780000] to-[#c1121f] 
                                              hover:from-[#c1121f] hover:to-[#780000] transition">
                                        Retirer rôle
                                    </a>
                                {% endif %}

                                <a href="{{ path('app_user_remove', {'id': user.id}) }}"
                                   onclick="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?')"
                                   class="px-3 py-1 rounded text-white text-sm bg-red-600 hover:bg-red-700 transition">
                                    Supprimer
                                </a>
                                <a href="{{ path('app_user_assign_role', {'id': user.id}) }}"
                                   class="px-3 py-1 rounded text-white text-sm 
                                   bg-green-600 hover:bg-green-700 transition"> Assigner rôle </a>
                                 <a href="{{ path('app_profile') }}"
                                   class="px-3 py-1 rounded text-white text-sm 
                                   bg-yellow-600 hover:bg-yellow-700 transition"> Voir profile </a>
                            {% endif %}

                        </td>

                    </tr>

                {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-4 text-center text-gray-500">
                            Aucun utilisateur trouvé
                        </td>
                    </tr>
                {% endfor %}

            </tbody>

        </table>
    </div>

</div>
{% endblock %}