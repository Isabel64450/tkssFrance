{% extends 'base.html.twig' %}

{% block title %}Page produit{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-10">


    <div class="bg-white shadow-lg rounded-2xl overflow-hidden grid grid-cols-1 md:grid-cols-2 gap-8 p-6">
        
      
        <div class="w-full aspect-square overflow-hidden rounded-2xl">
             <img src="{{ asset('uploads/images/' ~ product.images) }}" 
                  class="w-full h-full object-cover" 
                  alt="image produit">
        </div>

        
        <div class="flex flex-col justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 mb-4">
                    {{ product.name }}
                </h1>

                <p class="text-gray-600 mb-6">
                    {{ product.description }}
                </p>

                <h3 class="text-2xl font-bold text-green-600">
                    {{ product.price }} €
                </h3>
            </div>

            <a 
                href="#"
                class="mt-6 inline-block w-fit bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition"
            >
                Ajouter au panier
            </a>
        </div>
    </div>

    <!-- Produits récents -->
    <h2 class="text-2xl font-bold mt-12 mb-6">
        Derniers produits ajoutés
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {% for product in products %}
            <div class="bg-white shadow-md rounded-2xl overflow-hidden hover:shadow-lg transition">

                <div class="w-full aspect-square overflow-hidden rounded-2xl">
                    <img src="{{ asset('uploads/images/' ~ product.images) }}" 
                         class="w-full h-full object-cover" 
                         alt="image produit">
                </div>

                <div class="p-4">
                    <a href="{{ path('app_home_product_show', {'id': product.id}) }}">
                        <h5 class="text-lg font-semibold text-gray-800 hover:text-blue-600">
                            {{ product.name }}
                        </h5>
                    </a>

                    <p class="text-gray-600 text-sm mt-2">
                        {{ product.description|slice(0,60) }}...
                    </p>

                    <h3 class="text-xl font-bold text-green-600 mt-3">
                        {{ product.price }} €
                    </h3>

                    <a 
                        href="{{ path('app_cart_new', {'id': product.id}) }}"
                        class="mt-4 inline-block w-full text-center border border-green-600 text-green-600 py-2 rounded-lg hover:bg-green-600 hover:text-white transition"
                    >
                        Ajouter au panier
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}