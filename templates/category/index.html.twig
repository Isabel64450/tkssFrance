{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
<div class="container mx-auto mt-6 px-4">

    <div class="flex justify-between items-center mb-4">
        <h1 class="text-3xl font-bold text-[#003049]">Liste des catégories</h1>
        <a href="{{ path('app_category_new') }}" 
           class="px-4 py-2 bg-gradient-to-r from-[#780000] to-[#c1121f] text-white font-semibold rounded hover:from-[#c1121f] hover:to-[#780000] transition">
           Ajouter une catégorie
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full bg-white shadow-md rounded-lg">
            <thead class="bg-[#003049] text-white">
                <tr>
                    <th class="py-3 px-6 text-left">Nom</th>
                    <th class="py-3 px-6 text-left">Sous-catégories</th>
                    <th class="py-3 px-6 text-left">Actions</th>
                </tr>
            </thead>
            <tbody class="text-gray-800">
                {% for category in categories %}
                    <tr class="border-b hover:bg-[#fdf0d5]">
                        <td class="py-2 px-6 font-semibold">{{ category.name }}</td>
                        <td class="py-2 px-6">{{ category.subCategories|length }}</td>
                        <td class="py-2 px-6 space-x-2">
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                               class="px-3 py-1 bg-[#669bbc] text-white rounded hover:bg-[#003049] transition">Edit</a>
                            <a href="{{ path('app_category_delete', {'id': category.id}) }}"
                               class="px-3 py-1 bg-[#c1121f] text-white rounded hover:bg-[#780000] transition">Delete</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="py-4 text-center text-gray-500">Aucune catégorie disponible</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}