{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-6">

    <h2 class="text-3xl font-bold mb-6 text-gray-800">Liste des catégories</h2>

    {% include 'layouts/_flash_message.html.twig' %}

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gradient-to-r from-[#003049] to-[#669bbc] text-white">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold uppercase tracking-wider">Nom</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for category in categories %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-gray-700 font-medium">{{ category.name }}</td>
                        <td class="px-6 py-4 space-x-2">
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                               class="px-3 py-1 rounded text-white bg-gradient-to-r from-[#780000] to-[#c1121f] hover:from-[#c1121f] hover:to-[#780000] transition">
                                Edit
                            </a>
                            <a href="{{ path('app_category_delete', {'id': category.id}) }}" 
                               onclick="return confirm('Voulez-vous vraiment supprimer cette catégorie ?')"
                               class="px-3 py-1 rounded text-white bg-red-600 hover:bg-red-700 transition">
                                Delete
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="px-6 py-4 text-center text-gray-500">
                            Aucune catégorie trouvée
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-6">
        <a href="{{ path('app_category_new') }}" 
           class="inline-block px-5 py-2 rounded text-white font-semibold bg-gradient-to-r from-[#003049] to-[#669bbc] hover:from-[#669bbc] hover:to-[#003049] transition">
            Ajouter une nouvelle catégorie
        </a>
    </div>
</div>
{% endblock %}