{% extends 'base.html.twig' %}

{% block title %}SubCategory index{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fdf0d5] py-10 px-4">

    <div class="max-w-6xl mx-auto bg-white shadow-lg rounded-2xl border border-[#669bbc] p-6">

        <h1 class="text-3xl font-bold text-[#003049] mb-6 text-center">
            Liste des Sous-Catégories
        </h1>

        <div class="overflow-x-auto">
            <table class="min-w-full border border-[#669bbc] rounded-lg overflow-hidden">
                <thead class="bg-[#003049] text-white">
                    <tr>
                        <th class="py-3 px-4 text-left">Nom de Sous-Catégorie</th>
                        <th class="py-3 px-4 text-left">Catégorie</th>
                        <th class="py-3 px-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#669bbc]">
                    {% for sub_category in sub_categories %}
                        <tr class="hover:bg-[#fdf0d5] transition duration-200">
                            <td class="py-3 px-4 text-[#003049] font-medium">
                                {{ sub_category.name }}
                            </td>
                            <td class="py-3 px-4 text-[#669bbc] font-semibold">
                                {{ sub_category.category.name }}
                            </td>
                            <td class="py-3 px-4 flex space-x-2">
                                <a href="{{ path('app_sub_category_show', {'id': sub_category.id}) }}"
                                   class="px-3 py-1 bg-[#669bbc] hover:bg-[#003049] text-white rounded-lg transition duration-300">
                                    Show
                                </a>
                                <a href="{{ path('app_sub_category_edit', {'id': sub_category.id}) }}"
                                   class="px-3 py-1 bg-[#c1121f] hover:bg-[#780000] text-white rounded-lg transition duration-300">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center py-6 text-[#780000] font-semibold">
                                Aucun enregistrement trouvé
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-6 text-center">
            <a href="{{ path('app_sub_category_new') }}"
               class="inline-block px-6 py-2 bg-[#c1121f] hover:bg-[#780000] text-white font-semibold rounded-lg transition duration-300">
                Créer une nouvelle sous-catégorie
            </a>
        </div>

    </div>
</div>
{% endblock %}