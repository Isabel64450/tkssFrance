{% extends 'base.html.twig' %}

{% block title %}Sous-Catégorie{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fdf0d5] py-10 px-4">

    <div class="max-w-3xl mx-auto bg-white shadow-lg rounded-2xl border border-[#669bbc] p-8">

        <h1 class="text-3xl font-bold text-[#003049] mb-6 text-center">
            Détails de la Sous-Catégorie
        </h1>

        <div class="overflow-x-auto">
            <table class="min-w-full border border-[#669bbc] rounded-lg overflow-hidden">
                <tbody class="divide-y divide-[#669bbc]">

                    <tr class="hover:bg-[#fdf0d5] transition duration-200">
                        <th class="py-3 px-4 text-left text-[#003049] font-semibold">Id</th>
                        <td class="py-3 px-4 text-[#669bbc]">{{ sub_category.id }}</td>
                    </tr>

                    <tr class="hover:bg-[#fdf0d5] transition duration-200">
                        <th class="py-3 px-4 text-left text-[#003049] font-semibold">Nom</th>
                        <td class="py-3 px-4 text-[#c1121f] font-medium">{{ sub_category.name }}</td>
                    </tr>

                </tbody>
            </table>
        </div>

        <div class="mt-6 flex justify-center space-x-4">

            <a href="{{ path('app_sub_category_index') }}"
               class="px-4 py-2 bg-[#669bbc] hover:bg-[#003049] text-white font-semibold rounded-lg transition duration-300">
                ← Retour à la liste
            </a>

            <a href="{{ path('app_sub_category_edit', {'id': sub_category.id}) }}"
               class="px-4 py-2 bg-[#c1121f] hover:bg-[#780000] text-white font-semibold rounded-lg transition duration-300">
                Modifier
            </a>

            {{ include('sub_category/_delete_form.html.twig') | replace({
                'btn': '<button class="px-4 py-2 bg-[#780000] hover:bg-[#c1121f] text-white font-semibold rounded-lg transition duration-300">Supprimer</button>'
            }) }}

        </div>

    </div>
</div>
{% endblock %}