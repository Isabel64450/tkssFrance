{% if pageCount > 1 %}
<nav class="flex justify-center mt-8">
    <ul class="flex items-center space-x-2">

        {% if previous is defined %}
            <li>
                <a href="{{ path(route, query|merge({(pageParameterName):previous})) }}"
                   class="px-3 py-2 rounded bg-[#669bbc] text-white hover:bg-[#003049] transition">
                    ← Précédent
                </a>
            </li>
        {% endif %}

        {% for page in pagesInRange %}
            {% if page != current %}
                <li>
                    <a href="{{ path(route, query|merge({(pageParameterName):page})) }}"
                       class="px-3 py-2 rounded border border-gray-300 text-gray-700 hover:bg-[#fdf0d5] transition">
                        {{ page }}
                    </a>
                </li>
            {% else %}
                <li>
                    <span class="px-3 py-2 rounded text-white font-semibold 
                                 bg-gradient-to-r from-[#780000] to-[#c1121f]">
                        {{ page }}
                    </span>
                </li>
            {% endif %}
        {% endfor %}

        {% if next is defined %}
            <li>
                <a href="{{ path(route, query|merge({(pageParameterName):next})) }}"
                   class="px-3 py-2 rounded bg-[#669bbc] text-white hover:bg-[#003049] transition">
                    Suivant →
                </a>
            </li>
        {% endif %}

    </ul>
</nav>
{% endif %}