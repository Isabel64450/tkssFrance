{% for type, messages in app.flashes(['success','danger','info']) %}
    {% for message in messages %}

        <div class="max-w-3xl mx-auto mt-4">
            <div class="flex justify-between items-center px-4 py-3 rounded shadow-md text-white

                {% if type == 'success' %}
                    bg-green-500
                {% elseif type == 'danger' %}
                    bg-gradient-to-r from-[#780000] to-[#c1121f]
                {% elseif type == 'info' %}
                    bg-[#669bbc]
                {% endif %}
            ">

                <span>{{ message }}</span>

                <button onclick="this.parentElement.remove()" 
                        class="ml-4 text-white font-bold hover:text-gray-200">
                    ✕
                </button>

            </div>
        </div>

    {% endfor %}
{% endfor %}